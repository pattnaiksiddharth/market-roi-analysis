// ===============================================================================
// POWER BI DAX MEASURES FILE: MARKETING CAMPAIGN & ROI PERFORMANCE
// All ratios recompute dynamically from aggregated totals using DIVIDE() for zero-guard safety.
// ===============================================================================

// -------------------------------------------------------------------------------
// 1. BASELINE SUM AGGREGATIONS
// -------------------------------------------------------------------------------

Total Spend = 
SUM(fact_campaign[spend])
// Description: Total marketing dollar spend across all campaigns and channels.

Total Revenue = 
SUM(fact_campaign[revenue])
// Description: Total gross dollar revenue generated from campaigns.

Total Conversions = 
SUM(fact_campaign[conversions])
// Description: Aggregate customer acquisition transaction volume.

Total Impressions = 
SUM(fact_campaign[impressions])
// Description: Aggregate ad view volume.

Total Clicks = 
SUM(fact_campaign[clicks])
// Description: Aggregate ad click volume.

New Customers = 
[Total Conversions] * 0.60
// Description: Estimated first-time new customer conversions (assuming 60% new customer share).


// -------------------------------------------------------------------------------
// 2. PROFIT & MARGIN MEASURES
// -------------------------------------------------------------------------------

Total Profit = 
[Total Revenue] - [Total Spend]
// Description: Total dollar net profit generated (Revenue minus Spend).

Profit Margin % = 
DIVIDE([Total Profit], [Total Revenue], 0)
// Description: Net profit margin percentage ([Revenue - Spend] / Revenue).


// -------------------------------------------------------------------------------
// 3. RATIO & EFFICIENCY METRICS (SAFE DIVIDE)
// -------------------------------------------------------------------------------

CTR = 
DIVIDE([Total Clicks], [Total Impressions], 0)
// Description: Click-Through Rate (Clicks divided by Impressions).

CVR = 
DIVIDE([Total Conversions], [Total Clicks], 0)
// Description: Conversion Rate (Conversions divided by Clicks).

CPC = 
DIVIDE([Total Spend], [Total Clicks], 0)
// Description: Cost Per Click (Spend divided by Clicks).

CPA = 
DIVIDE([Total Spend], [Total Conversions], 0)
// Description: Cost Per Acquisition / Conversion.

CAC = 
DIVIDE([Total Spend], [New Customers], 0)
// Description: Customer Acquisition Cost (Spend divided by New Customers).

Revenue per Conversion = 
DIVIDE([Total Revenue], [Total Conversions], 0)
// Description: Effective Average Revenue generated per conversion transaction (Effective AOV).

ROAS = 
DIVIDE([Total Revenue], [Total Spend], 0)
// Description: Return on Ad Spend (Revenue divided by Spend).

ROI = 
DIVIDE([Total Profit], [Total Spend], 0)
// Description: Return on Investment percentage ((Revenue - Spend) / Spend).


// -------------------------------------------------------------------------------
// 4. PERFORMANCE HIGHLIGHTS & RANKINGS
// -------------------------------------------------------------------------------

Spend Share % = 
DIVIDE(
    [Total Spend], 
    CALCULATE([Total Spend], ALL(dim_channel)), 
    0
)
// Description: Percentage of total portfolio marketing spend allocated to the selected channel(s).

Revenue Share % = 
DIVIDE(
    [Total Revenue], 
    CALCULATE([Total Revenue], ALL(dim_channel)), 
    0
)
// Description: Percentage of total portfolio revenue generated by the selected channel(s).

ROI Rank = 
RANKX(
    ALL(dim_channel[channel]), 
    [ROI], 
    , 
    DESC, 
    Dense
)
// Description: Dynamic rank order of channels sorted by ROI percentage (1 = Highest ROI).

Loss Making Campaigns Count = 
CALCULATE(
    COUNTROWS(fact_campaign),
    FILTER(fact_campaign, fact_campaign[revenue] < fact_campaign[spend])
)
// Description: Count of individual campaigns operating at a net loss (Revenue < Spend).

Best Channel by ROI = 
TOPN(
    1,
    VALUES(dim_channel[channel]),
    [ROI],
    DESC
)
// Description: Name of the top-performing channel ranked by ROI.

Worst Channel by ROI = 
TOPN(
    1,
    VALUES(dim_channel[channel]),
    [ROI],
    ASC
)
// Description: Name of the lowest-performing channel ranked by ROI.


// -------------------------------------------------------------------------------
// 5. BUDGET REALLOCATION WHAT-IF SCENARIO MEASURES
// -------------------------------------------------------------------------------

// Note: Requires a calculated parameter table named 'Scenario_Parameters' with column 'Reallocation_Pct'

Shifted Spend = 
VAR BaseSpend = [Total Spend]
VAR Multiplier = SELECTEDVALUE('Scenario_Parameters'[Reallocation_Pct], 1.0)
RETURN
    BaseSpend * Multiplier
// Description: Spend under what-if budget reallocation scenario.

Projected Revenue = 
VAR BaseRevenue = [Total Revenue]
VAR Multiplier = SELECTEDVALUE('Scenario_Parameters'[Reallocation_Pct], 1.0)
RETURN
    BaseRevenue * Multiplier
// Description: Projected gross revenue under what-if scenario.

Projected Net Profit = 
[Projected Revenue] - [Shifted Spend]
// Description: Projected dollar profit under budget reallocation scenario.

Projected ROI = 
DIVIDE([Projected Net Profit], [Shifted Spend], 0)
// Description: Projected ROI percentage under budget reallocation scenario.


// -------------------------------------------------------------------------------
// 6. SCENARIO PARAMETER TABLE GENERATION (DAX Calculated Table)
// -------------------------------------------------------------------------------
/*
Scenario_Parameters = 
DATATABLE(
    "Scenario_Name", STRING,
    "Reallocation_Pct", DOUBLE,
    {
        {"Conservative (-20% Low-ROI, +10% High-ROI)", 0.80},
        {"Base Baseline (Current)", 1.00},
        {"Optimistic (-50% Low-ROI, +30% High-ROI)", 1.30}
    }
)
*/
